# ==============================================================================
# Mangalore Bus Routes - GitHub Route Correction Integration Configuration
# ==============================================================================
# To enable community route corrections to create live branches and pull requests
# on GitHub, create a .env.local file in the project root and fill in the values below.
#
# 1. GITHUB_TOKEN:
#    - Create a Fine-Grained Personal Access Token at:
#      https://github.com/settings/tokens?type=beta
#    - Repository Access: Selected repositories -> (Your repository or fork)
#    - Permissions Required:
#      * Repository Permissions -> Contents: Read and write
#      * Repository Permissions -> Pull requests: Read and write
#
# 2. GITHUB_REPO_OWNER:
#    - For original maintainer: "mrkushalsm"
#    - For forks: Your GitHub username (e.g. "TXPratham")
#
# 3. GITHUB_REPO_NAME:
#    - The repository name (default: "Mangalore-Bus-Routes")
#
# 4. GITHUB_BASE_BRANCH:
#    - Base branch to target for pull requests (default: "master")
# ==============================================================================

GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO_OWNER=mrkushalsm
GITHUB_REPO_NAME=Mangalore-Bus-Routes
GITHUB_BASE_BRANCH=master
